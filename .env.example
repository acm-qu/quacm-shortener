# Local development settings.
# Copy this file to .env (same folder) and fill in real values:
#     Copy-Item .env.example .env
# On cPanel you will NOT upload this file - you set the same
# variables in the Python app's "Environment Variables" screen (Stage 5).

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Replace YOUR-PG-PASSWORD with the password you chose when installing
# PostgreSQL 9.6 (the "postgres" superuser password).
DATABASE_URL=postgresql://postgres:YOUR-PG-PASSWORD@localhost:5432/quacm

# Long random string used to sign cookies/sessions. Needed from Stage 2.
# Tip: generate one in PowerShell:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here

# The very first admin account is created automatically on first start,
# but ONLY if no admin exists yet and ONLY if the password is 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=paste-a-password-of-12-plus-characters

# Set to 1 ONLY in production on cPanel (Stage 5), where Apache sits in
# front of the app. Switches on: HTTPS-only session cookies, trusting the
# real visitor IP (X-Forwarded-For) for rate limiting, and the strict
# SECRET_KEY startup check. Leave this line out (or 0) locally.
TRUST_PROXY=0

# Public address of this shortener, used to build full links such as
# https://link.qu.acm.org/slug on the dashboard and inside QR codes.
# Leave it commented out locally: the app then uses whichever host you
# browsed from (e.g. http://127.0.0.1:5000). Uncomment for production.
#BASE_URL=https://link.qu.acm.org
